---
/** Karriere als dunkles Band mit großer Aussage und Benefit-Chips. */
import type { AktiveSektion } from '../../../lib/config';
import { config, t } from '../../../lib/config';
import { aktiv } from '../../../lib/routes';
import Icon from '../../ui/Icon.astro';
import Button from '../../ui/Button.astro';

interface Props {
  s: Extract<AktiveSektion, { typ: 'karriere' }>;
}
const { s } = Astro.props;
const n = config.stellen.length;
---

<div class="kb invers">
  <div class="wrap kb-raster">
    <div>
      <p class="kb-zahl ziffern">{n === 0 ? t('nav.karriere') : n === 1 ? t('karriere.anzahlEine') : t('karriere.anzahlMehrere', { anzahl: n })}</p>
      <h2 class="h2" data-anim="zeilen">{s.titel ?? config.karriere.titel ?? t('karriere.titel')}</h2>
    </div>
    <div class="kb-text">
      <p class="lead" data-anim="reveal-up">{s.intro ?? config.karriere.intro ?? t('karriere.intro')}</p>
      <ul class="kb-chips" role="list" data-anim-kinder>
        {
          config.benefits.map((b) => (
            <li>
              <Icon name={b.icon} size={18} />
              {b.titel}
            </li>
          ))
        }
      </ul>
      {aktiv('karriere') && <Button href="/karriere/" variante="hell">{t('aktion.offeneStellen')}</Button>}
    </div>
  </div>
</div>

<style>
  .kb {
    padding-block: clamp(4rem, 3rem + 5vw, 8rem);
  }
  :global([data-preset='warm']) .kb {
    margin-inline: clamp(0.5rem, 2vw, 1.5rem);
    border-radius: var(--r-xl);
  }
  .kb-raster {
    display: grid;
    gap: 2.5rem;
  }
  .kb-zahl {
    margin-bottom: 1rem;
    font-weight: 650;
    color: var(--brand-on-inverse);
  }
  .kb-text {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    align-content: end;
  }
  .kb-text .lead {
    color: var(--on-inverse-muted);
  }
  .kb-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .kb-chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--inverse-line);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
  }
  @media (min-width: 64rem) {
    .kb-raster {
      grid-template-columns: 1fr 1fr;
      column-gap: calc(var(--gutter) * 3);
    }
  }
</style>
