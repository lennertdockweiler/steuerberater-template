---
/**
 * Logo der Kanzlei. Ohne Logo-Datei entsteht automatisch eine typografische
 * Wortmarke aus dem Namen; ihre Form richtet sich nach dem Stil-Preset.
 */
import { config, design, t } from '../../lib/config';
import { ladeBild } from '../../lib/bilder';

interface Props {
  hell?: boolean;
  gross?: boolean;
}
const { hell = false, gross = false } = Astro.props;
const b = config.branding;
const logoDatei = b.logo ? (hell && b.logo.dateiHell ? b.logo.dateiHell : b.logo.datei) : undefined;
const logo = await ladeBild(logoDatei);
const zeile1 = b.wortmarke?.zeile1 ?? config.betrieb.kurzname;
const zeile2 = b.wortmarke?.zeile2 ?? t('wortmarke.zusatz');
const initialen = zeile1
  .split(/\s+/)
  .filter((w) => /^[A-ZÄÖÜ]/.test(w))
  .slice(0, 2)
  .map((w) => w[0])
  .join('');
const hoehe = (b.logo?.hoehe ?? 36) * (gross ? 1.5 : 1);
---

{
  logo ? (
    <img
      src={logo.src}
      width={Math.round((logo.width / logo.height) * hoehe)}
      height={hoehe}
      alt={b.logo?.alt ?? config.betrieb.name}
      class="logo-bild"
      decoding="async"
    />
  ) : (
    <span class:list={['wortmarke', `wm-${design.presetKey}`, gross && 'wm-gross', hell && 'wm-hell']}>
      {design.presetKey === 'warm' && (
        <span class="wm-monogramm" aria-hidden="true">
          {initialen}
        </span>
      )}
      <span class="wm-text">
        <span class="wm-name">{zeile1}</span>
        {design.presetKey === 'klar' && <span class="wm-strich" aria-hidden="true" />}
        <span class="wm-zusatz">{zeile2}</span>
      </span>
    </span>
  )
}

<style>
  .logo-bild {
    display: block;
    width: auto;
  }
  .wortmarke {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    line-height: 1;
    white-space: nowrap;
  }
  .wm-hell {
    color: var(--on-inverse);
  }
  .wm-text {
    display: inline-grid;
    gap: 0.28rem;
  }
  .wm-name {
    font-family: var(--ff-display);
    font-weight: 720;
    font-size: 1.12rem;
    letter-spacing: -0.03em;
  }
  .wm-zusatz {
    font-size: 0.68rem;
    font-weight: 550;
    letter-spacing: 0.01em;
    color: var(--ink-muted);
  }
  .wm-hell .wm-zusatz {
    color: var(--on-inverse-muted);
  }
  /* Klar: Summenstrich zwischen Name und Zusatz */
  .wm-strich {
    display: block;
    height: 4px;
    border-block: 1px solid var(--brand-ink);
  }
  .wm-hell .wm-strich {
    border-color: var(--brand-on-inverse);
  }
  /* Klassisch: Serif, ruhig, Messinglinie */
  .wm-klassisch .wm-name {
    font-weight: 500;
    font-size: 1.28rem;
    letter-spacing: -0.01em;
  }
  .wm-klassisch .wm-zusatz {
    padding-top: 0.3rem;
    border-top: 1px solid var(--accent);
    letter-spacing: 0.06em;
  }
  /* Warm: Monogramm-Kreis */
  .wm-monogramm {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--brand);
    color: var(--on-brand);
    font-family: var(--ff-display);
    font-weight: 750;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }
  .wm-warm .wm-name {
    font-weight: 780;
    letter-spacing: -0.025em;
  }
  .wm-gross .wm-name {
    font-size: 1.6rem;
  }
  .wm-gross .wm-zusatz {
    font-size: 0.85rem;
  }
  .wm-gross .wm-monogramm {
    width: 3.4rem;
    height: 3.4rem;
    font-size: 1.2rem;
  }
</style>
