---
/**
 * Akkordeon mit nativem <details>/<summary>: ohne JS bedienbar, tastaturtauglich,
 * Screenreader-freundlich. `name` sorgt dafür, dass jeweils nur eine Antwort offen ist.
 */
import Icon from './Icon.astro';

interface Props {
  eintraege: { frage: string; antwort: string }[];
  name?: string;
  ersteOffen?: boolean;
}
const { eintraege, name = 'akkordeon', ersteOffen = false } = Astro.props;
---

<div class="akk" data-akkordeon>
  {
    eintraege.map((e, i) => (
      <details name={name} open={ersteOffen && i === 0 ? true : undefined}>
        <summary>
          <span class="akk-frage">{e.frage}</span>
          <span class="akk-icon" aria-hidden="true">
            <Icon name="plus" size={20} strich={2} />
          </span>
        </summary>
        <div class="akk-antwort">
          <p>{e.antwort}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .akk {
    border-top: 1px solid var(--line-strong);
  }
  details {
    border-bottom: 1px solid var(--line-strong);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 3.5rem;
    padding: 1.15rem 0;
    cursor: pointer;
    list-style: none;
    font-weight: 650;
    font-size: var(--step-1);
    line-height: 1.3;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover .akk-frage {
    color: var(--brand-ink);
  }
  .akk-icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      transform 400ms var(--ease-out),
      background-color 300ms,
      color 300ms;
  }
  details[open] .akk-icon {
    transform: rotate(45deg);
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  .akk-antwort {
    padding: 0 3.5rem 1.5rem 0;
    color: var(--ink-muted);
    max-width: var(--measure);
  }
  details[open] .akk-antwort {
    animation: antwort-ein 450ms var(--ease-out);
  }
  @keyframes antwort-ein {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
