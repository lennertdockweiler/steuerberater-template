---
/** Teaser für den Mandanten-Check als Markenfarben-Band mit Vorschau der ersten Frage. */
import type { AktiveSektion } from '../../../lib/config';
import { config, t, titelOder } from '../../../lib/config';
import { aktiv } from '../../../lib/routes';
import Button from '../../ui/Button.astro';
import Icon from '../../ui/Icon.astro';

interface Props {
  s: AktiveSektion;
}
const { s } = Astro.props;
const mc = config.mandantenCheck;
if (!mc || !aktiv('mandantenCheck')) return;
const erste = mc.fragen[0];
---

<div class="wrap">
  <div class="cbn">
    <div class="cbn-text">
      <h2 class="h2" data-anim="zeilen">{titelOder(s.titel ?? mc.titel, 'check.titel')}</h2>
      <p data-anim="reveal-up">{s.intro ?? mc.intro ?? t('check.intro')}</p>
      <div data-anim="reveal-up"><Button href="/mandanten-check/" variante="hell" magnet>{t('aktion.checkStarten')}</Button></div>
    </div>
    <div class="cbn-vorschau" aria-hidden="true">
      <p class="cbn-frage">{erste.frage}</p>
      <ul role="list" data-anim-kinder>
        {
          erste.optionen.slice(0, 4).map((o) => (
            <li>
              {o.icon && <Icon name={o.icon} size={18} />}
              {o.label}
            </li>
          ))
        }
      </ul>
      <div class="cbn-fortschritt"><span></span></div>
    </div>
  </div>
</div>

<style>
  .cbn {
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.75rem, 1rem + 4vw, 4.5rem);
    border-radius: var(--r-xl);
    background: var(--brand);
    color: var(--on-brand);
    overflow: hidden;
  }
  .cbn-text {
    display: grid;
    gap: 1.25rem;
    align-content: center;
    justify-items: start;
  }
  .cbn-text p {
    max-width: 44ch;
    opacity: 0.88;
  }
  .cbn-text :global(.btn-hell) {
    --btn-bg: var(--on-brand);
    --btn-fg: var(--brand);
    --btn-bd: var(--on-brand);
  }
  .cbn-vorschau {
    display: grid;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: var(--r-lg);
    background: color-mix(in oklab, var(--on-brand) 10%, transparent);
    border: 1px solid color-mix(in oklab, var(--on-brand) 22%, transparent);
    rotate: -1.5deg;
  }
  .cbn-frage {
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .cbn-vorschau ul {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cbn-vorschau li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border-radius: var(--r-md);
    background: color-mix(in oklab, var(--on-brand) 12%, transparent);
    font-weight: 600;
    font-size: 0.95rem;
  }
  .cbn-vorschau li:first-child {
    background: var(--on-brand);
    color: var(--brand);
  }
  .cbn-fortschritt {
    height: 4px;
    margin-top: 0.5rem;
    border-radius: 2px;
    background: color-mix(in oklab, var(--on-brand) 20%, transparent);
  }
  .cbn-fortschritt span {
    display: block;
    width: 20%;
    height: 100%;
    border-radius: 2px;
    background: var(--on-brand);
  }
  @media (min-width: 64rem) {
    .cbn {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      column-gap: 4rem;
    }
  }
</style>
