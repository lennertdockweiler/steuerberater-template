---
/** Leistungen als Bento-Grid: eine große Kachel mit Bild, die übrigen in wechselnden Größen. */
import type { AktiveSektion } from '../../../lib/config';
import { config, t, titelOder, leistungPfad, zielgruppeBySlug } from '../../../lib/config';
import { aktiv } from '../../../lib/routes';
import SektionKopf from '../../ui/SektionKopf.astro';
import Foto from '../../ui/Foto.astro';
import Icon from '../../ui/Icon.astro';
import Button from '../../ui/Button.astro';

interface Props {
  s: Extract<AktiveSektion, { typ: 'leistungen' }>;
}
const { s } = Astro.props;
const liste = (s.auswahl ? config.leistungen.filter((l) => s.auswahl!.includes(l.slug)) : config.leistungen).slice(0, 7);
const erste = liste[0];
const bild = erste.bild ?? zielgruppeBySlug(erste.zielgruppe[0])?.bild;
---

<div class="wrap">
  <SektionKopf kicker={s.kicker} titel={titelOder(s.titel, 'leistungen.titel')} intro={s.intro ?? t('leistungen.intro')}>
    {aktiv('leistungen') && <Button href="/leistungen/" variante="sekundaer">{t('aktion.alleLeistungen')}</Button>}
  </SektionKopf>
  <ul class="bento" role="list" data-anim-kinder>
    {
      liste.map((l, i) => (
        <li class:list={['bento-kachel', `bk-${i}`, i === 0 && 'bento-gross', i === 3 && 'bento-akzent']}>
          <a href={aktiv('leistungen') ? leistungPfad(l) : '/kontakt/'}>
            {i === 0 && <Foto bild={bild ? { ...bild, dekorativ: true, alt: '' } : undefined} ratio="16 / 10" sizes="(min-width: 64rem) 50vw, 100vw" class="bento-bild" />}
            <span class="bento-icon">
              <Icon name={l.icon} size={24} />
            </span>
            <span class="bento-titel">{l.titel}</span>
            <span class="bento-text">{l.kurztext}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .bento {
    display: grid;
    gap: var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bento-kachel a {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.6rem;
    height: 100%;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--surface);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform 400ms var(--ease-out),
      background-color 300ms;
  }
  .bento-kachel a:hover {
    transform: translateY(-4px);
    background: var(--surface-2);
  }
  .bento-gross a {
    background: var(--inverse);
    color: var(--on-inverse);
    --ink-muted: var(--on-inverse-muted);
  }
  .bento-gross a:hover {
    background: var(--inverse-2);
  }
  .bento-akzent a {
    background: var(--brand);
    color: var(--on-brand);
    --ink-muted: color-mix(in oklab, var(--on-brand) 82%, transparent);
  }
  .bento-akzent a:hover {
    background: var(--brand-hover);
  }
  .bento-kachel :global(.bento-bild) {
    margin: calc(clamp(1.25rem, 1rem + 1vw, 2rem) * -1) calc(clamp(1.25rem, 1rem + 1vw, 2rem) * -1) 1rem;
    border-radius: 0;
  }
  .bento-icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--r-md);
    background: color-mix(in oklab, currentColor 10%, transparent);
  }
  .bento-titel {
    margin-top: 0.75rem;
    font-family: var(--ff-display);
    font-weight: var(--hl-weight);
    font-size: var(--step-1);
    letter-spacing: calc(var(--hl-tracking) * 0.5);
    line-height: 1.2;
  }
  .bento-gross .bento-titel {
    font-size: var(--step-3);
    letter-spacing: var(--hl-tracking);
  }
  .bento-text {
    font-size: 0.95rem;
    color: var(--ink-muted);
  }
  @media (min-width: 48rem) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .bento-gross {
      grid-column: span 2;
    }
  }
  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: minmax(13rem, auto);
    }
    .bento-gross {
      grid-column: span 2;
      grid-row: span 2;
    }
    .bk-3 {
      grid-column: span 2;
    }
    .bk-6 {
      grid-column: span 2;
    }
  }
</style>
