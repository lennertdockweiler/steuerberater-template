---
/**
 * Stilisierte Karten-Vorschau (reines SVG, keine externe Verbindung).
 * Straßenraster und Wasserlauf werden aus den Koordinaten abgeleitet,
 * damit jede Kanzlei ein eigenes, aber ruhiges Bild bekommt.
 */
interface Props {
  lat: number;
  lng: number;
}
const { lat, lng } = Astro.props;
// einfacher deterministischer Zufall aus den Koordinaten
let saat = Math.abs(Math.round(lat * 1e4) * 31 + Math.round(lng * 1e4));
const zufall = () => {
  saat = (saat * 9301 + 49297) % 233280;
  return saat / 233280;
};
const strassen = Array.from({ length: 9 }, (_, i) => ({ x: 40 + i * 95 + zufall() * 30, w: zufall() > 0.7 ? 7 : 3 }));
const quer = Array.from({ length: 6 }, (_, i) => ({ y: 30 + i * 85 + zufall() * 25, w: zufall() > 0.7 ? 7 : 3, r: (zufall() - 0.5) * 8 }));
const fluss = `M -20 ${300 + zufall() * 60} C 200 ${200 + zufall() * 80}, 380 ${420 + zufall() * 60}, 560 ${330 + zufall() * 40} S 860 ${220 + zufall() * 60}, 980 ${300 + zufall() * 40}`;
---

<svg class="kv" viewBox="0 0 900 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="900" height="500" class="kv-grund"></rect>
  <g class="kv-bloecke">
    {Array.from({ length: 14 }, () => <rect x={zufall() * 860} y={zufall() * 460} width={40 + zufall() * 90} height={30 + zufall() * 70} rx="4" />)}
  </g>
  <path d={fluss} class="kv-fluss"></path>
  <g class="kv-strassen">
    {strassen.map((s) => <line x1={s.x} y1="-10" x2={s.x + 40} y2="510" stroke-width={s.w} />)}
    {quer.map((q) => <line x1="-10" y1={q.y} x2="910" y2={q.y + q.r * 10} stroke-width={q.w} />)}
  </g>
  <g class="kv-pin" transform="translate(450 230)">
    <circle r="34" class="kv-puls"></circle>
    <path d="M0 22 C -16 2, -18 -6, -18 -14 A 18 18 0 1 1 18 -14 C 18 -6, 16 2, 0 22 Z" class="kv-nadel"></path>
    <circle cy="-14" r="6.5" class="kv-punkt"></circle>
  </g>
</svg>

<style>
  .kv {
    width: 100%;
    height: 100%;
    display: block;
  }
  .kv-grund {
    fill: var(--surface);
  }
  .kv-bloecke rect {
    fill: var(--surface-2);
  }
  .kv-fluss {
    fill: none;
    stroke: color-mix(in oklab, var(--brand) 22%, var(--surface));
    stroke-width: 26;
    stroke-linecap: round;
  }
  .kv-strassen line {
    stroke: var(--bg);
    stroke-linecap: round;
  }
  .kv-nadel {
    fill: var(--brand);
  }
  .kv-punkt {
    fill: var(--on-brand);
  }
  .kv-puls {
    fill: var(--brand);
    opacity: 0.18;
    transform-origin: 0 0;
    animation: kv-puls 2.4s var(--ease-out) infinite;
  }
  @keyframes kv-puls {
    from {
      transform: scale(0.4);
      opacity: 0.35;
    }
    to {
      transform: scale(1.6);
      opacity: 0;
    }
  }
</style>
