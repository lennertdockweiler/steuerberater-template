---
/**
 * Hero (c): Zielgruppen-Weiche. „Ich …“ mit großen Auswahlkarten, die direkt
 * zur passenden Leistungsseite führen.
 */
import type { AktiveSektion } from '../../../lib/config';
import { config, t } from '../../../lib/config';
import { aktiv } from '../../../lib/routes';
import Icon from '../../ui/Icon.astro';

interface Props {
  s: Extract<AktiveSektion, { typ: 'hero' }>;
}
const { s } = Astro.props;
const titel = s.titel ?? t('hero.weicheTitel');
const kicker = s.kicker ?? t('hero.kickerWeiche');
const ziel = (slug: string) => (aktiv('leistungen') ? `/leistungen/${slug}/` : '/kontakt/');
---

<section class="hero-we" aria-labelledby="hero-titel">
  <div class="wrap">
    <div class="hero-we-kopf">
      <p class="kicker">{kicker}</p>
      <h1 id="hero-titel" class="display hero-we-titel">{titel}</h1>
      {s.unterzeile && <p class="lead">{s.unterzeile}</p>}
    </div>
    <ul class="hero-we-karten" role="list">
      {
        config.zielgruppen.map((z, i) => (
          <li style={`--i:${i}`}>
            <a href={ziel(z.slug)} class="we-karte">
              <span class="we-icon">
                <Icon name={z.icon} size={28} strich={1.5} />
              </span>
              <span class="we-ich">{z.ichBin}</span>
              <span class="we-text">{z.kurztext}</span>
              <span class="we-pfeil" aria-hidden="true">
                <Icon name="arrow-right" size={22} strich={1.75} />
              </span>
              <span class="we-strich" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero-we {
    padding-top: calc(var(--header-h) + clamp(2rem, 1rem + 4vw, 5rem));
    padding-bottom: clamp(3.5rem, 2rem + 5vw, 7rem);
  }
  .hero-we-kopf {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    max-width: 52rem;
  }
  .hero-we-kopf .kicker {
    margin-bottom: 0;
  }
  .hero-we-titel {
    font-size: calc(var(--step-5) * 0.9);
    animation: titel-auf 1.1s var(--ease-out) both;
  }
  @keyframes titel-auf {
    from {
      transform: translateY(0.25em);
      opacity: 0.35;
    }
  }
  .hero-we-karten {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-we-karten li {
    animation: karte-auf 900ms var(--ease-out) both;
    animation-delay: calc(350ms + var(--i) * 90ms);
  }
  @keyframes karte-auf {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  .we-karte {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'icon ich pfeil' 'icon text pfeil';
    column-gap: 1.1rem;
    row-gap: 0.35rem;
    align-items: center;
    min-height: 100%;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--bg);
    text-decoration: none;
    overflow: hidden;
    transition:
      transform var(--dur-2) var(--ease-out),
      border-color var(--dur-2);
  }
  .we-karte:hover {
    transform: translateY(-4px);
    border-color: var(--ink);
  }
  .we-karte:active {
    transform: scale(0.99);
  }
  .we-icon {
    grid-area: icon;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--r-md);
    background: var(--brand-soft);
    color: var(--brand-ink);
    align-self: start;
  }
  .we-ich {
    grid-area: ich;
    font-family: var(--ff-display);
    font-weight: var(--hl-weight);
    font-size: var(--step-2);
    letter-spacing: var(--hl-tracking);
    line-height: 1.1;
  }
  .we-text {
    grid-area: text;
    font-size: 0.95rem;
    color: var(--ink-muted);
  }
  .we-pfeil {
    grid-area: pfeil;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      transform var(--dur-2) var(--ease-out),
      background-color var(--dur-2),
      color var(--dur-2);
  }
  .we-karte:hover .we-pfeil {
    transform: translateX(4px);
    background: var(--brand);
    color: var(--on-brand);
    border-color: var(--brand-edge);
  }
  .we-strich {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5px;
    border-block: 1.5px solid var(--brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 600ms var(--ease-out);
  }
  .we-karte:hover .we-strich,
  .we-karte:focus-visible .we-strich {
    transform: scaleX(1);
  }
  @media (min-width: 48rem) {
    .hero-we-karten {
      grid-template-columns: 1fr 1fr;
      gap: var(--gutter);
    }
    .we-karte {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'icon pfeil' 'ich ich' 'text text';
      row-gap: 0.75rem;
      align-items: start;
    }
    .we-icon {
      margin-bottom: 1.5rem;
    }
  }
</style>
