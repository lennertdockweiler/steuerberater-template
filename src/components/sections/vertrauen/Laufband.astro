---
/** Mitgliedschaften und Software als ruhiges Laufband. */
import type { AktiveSektion } from '../../../lib/config';
import { config, titelOder } from '../../../lib/config';

interface Props {
  s: AktiveSektion;
}
const { s } = Astro.props;
const eintraege = [...config.mitgliedschaften.map((m) => m.name), ...config.software.map((x) => x.name)];
if (!eintraege.length) return;
---

<div class="vl">
  <h2 class="sr-only">{titelOder(s.titel, 'vertrauen.titel')}</h2>
  <div class="vl-band" tabindex="0" role="region" aria-label={titelOder(s.titel, 'vertrauen.titel')}>
    {
      [0, 1].map((k) => (
        <ul class="vl-spur" role="list" aria-hidden={k === 1 ? 'true' : undefined}>
          {eintraege.map((e) => (
            <li>{e}</li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .vl-band {
    display: flex;
    overflow: clip;
    padding-block: 1.25rem;
    border-block: 1px solid var(--line);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .vl-spur {
    display: flex;
    flex: none;
    gap: 3.5rem;
    margin: 0;
    padding: 0 3.5rem 0 0;
    list-style: none;
    animation: vl-laufen 45s linear infinite;
  }
  .vl-band:hover .vl-spur,
  .vl-band:focus-within .vl-spur {
    animation-play-state: paused;
  }
  .vl-spur li {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    white-space: nowrap;
    font-family: var(--ff-display);
    font-weight: var(--hl-weight);
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    color: var(--ink-muted);
  }
  .vl-spur li::after {
    content: '';
    width: 1.2rem;
    height: 5px;
    border-block: 1px solid var(--brand-ink);
  }
  @keyframes vl-laufen {
    to {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vl-band {
      overflow-x: auto;
      mask-image: none;
    }
    .vl-spur {
      animation: none;
    }
    .vl-spur[aria-hidden='true'] {
      display: none;
    }
  }
</style>
