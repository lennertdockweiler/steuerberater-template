---
/** Typografie für Fließtext aus Markdown oder Config-Absätzen. */
interface Props {
  class?: string;
}
const { class: klasse } = Astro.props;
---

<div class:list={['prosa', klasse]}><slot /></div>

<style>
  .prosa {
    max-width: var(--measure);
    font-size: 1.075rem;
    line-height: 1.7;
  }
  .prosa :global(> * + *) {
    margin-top: 1.1em;
  }
  .prosa :global(h2) {
    margin-top: 2.2em;
    font-size: var(--step-2);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .prosa :global(h3) {
    margin-top: 1.8em;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .prosa :global(ul),
  .prosa :global(ol) {
    padding-left: 1.25em;
  }
  .prosa :global(li + li) {
    margin-top: 0.45em;
  }
  .prosa :global(li::marker) {
    color: var(--brand-ink);
  }
  .prosa :global(strong) {
    font-weight: 680;
  }
  .prosa :global(a) {
    color: var(--brand-ink);
    font-weight: 600;
  }
  .prosa :global(blockquote) {
    margin-inline: 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--brand);
    font-style: italic;
  }
  .prosa :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .prosa :global(th),
  .prosa :global(td) {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
  }
</style>
